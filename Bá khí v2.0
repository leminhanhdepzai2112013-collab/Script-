--========================================================
-- 12. TÌM PROMPT CỦA TRỨNG
--========================================================

local function FindEggPrompt(Egg)

    if not Egg then
        return nil
    end

    -- Ưu tiên prompt nằm trong trứng
    local Prompt = Egg:FindFirstChildWhichIsA(
        "ProximityPrompt",
        true
    )

    if Prompt then
        return Prompt
    end

    -- Nếu không có prompt trong trứng,
    -- tìm prompt gần vị trí trứng
    local EggPosition = Egg:GetAttribute("Position")

    if typeof(EggPosition) ~= "Vector3" then

        local Part = Egg:IsA("BasePart")
            and Egg
            or Egg:FindFirstChildWhichIsA("BasePart", true)

        if Part then
            EggPosition = Part.Position
        end
    end

    if typeof(EggPosition) ~= "Vector3" then
        return nil
    end

    for _, Obj in ipairs(workspace:GetDescendants()) do

        if Obj:IsA("ProximityPrompt") then

            local Parent = Obj.Parent

            if Parent and Parent:IsA("BasePart") then

                if (Parent.Position - EggPosition).Magnitude <= 8 then
                    return Obj
                end

            end
        end
    end

    return nil
end

--========================================================
-- 13. NHẶT TRỨNG
--========================================================

local function PickEgg(Egg, Button)

    if not Egg or not Egg.Parent then

        Button.Text = "❌ TRỨNG KHÔNG CÒN"

        task.wait(1)

        Button.Text = "🥚 NHẶT"

        return
    end

    Character = Player.Character or Character

    Root = Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return
    end

    -- Lưu vị trí trước khi teleport
    OldPosition = Root.CFrame

    local EggPosition = Egg:GetAttribute("Position")

    if typeof(EggPosition) ~= "Vector3" then

        local Part = Egg:IsA("BasePart")
            and Egg
            or Egg:FindFirstChildWhichIsA("BasePart", true)

        if Part then
            EggPosition = Part.Position
        end
    end

    if typeof(EggPosition) ~= "Vector3" then

        Button.Text = "❌ KHÔNG CÓ VỊ TRÍ"

        task.wait(1)

        Button.Text = "🥚 NHẶT"

        return
    end

    Button.Text = "⏳ ĐANG NHẶT..."

    -- Tele đến trứng
    Root.CFrame = CFrame.new(
        EggPosition + Vector3.new(0, 3, 0)
    )

    task.wait(0.15)

    -- Tìm prompt
    local Prompt = FindEggPrompt(Egg)

    if Prompt then

        pcall(function()

            if fireproximityprompt then
                fireproximityprompt(Prompt)
            else
                Prompt:InputHoldBegin()
                task.wait(Prompt.HoldDuration + 0.05)
                Prompt:InputHoldEnd()
            end

        end)

    end

    task.wait(0.25)

    -- Quay lại chỗ cũ
    if Root and OldPosition then
        Root.CFrame = OldPosition
    end

    Button.Text = "🥚 NHẶT"

end

--========================================================
-- 14. TẠO 1 DÒNG TRỨNG
--========================================================

local EggRows = {}

local function CreateEggRow(Egg)

    local EggName, Luck = GetEggInfo(Egg)

    local Row = Instance.new("Frame")
    Row.Name = "Egg_" .. tostring(EggName)
    Row.Size = UDim2.new(1, -10, 0, 58)
    Row.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Row.BorderSizePixel = 0
    Row.Parent = TakePage

    local Info = Instance.new("TextLabel")
    Info.Size = UDim2.new(1, -90, 1, 0)
    Info.Position = UDim2.new(0, 8, 0, 0)
    Info.BackgroundTransparency = 1
    Info.TextColor3 = Color3.fromRGB(255, 255, 255)
    Info.TextSize = 13
    Info.TextXAlignment = Enum.TextXAlignment.Left
    Info.Text = "🥚 " .. tostring(EggName)
        .. "\n🍀 Luck: "
        .. FormatNumber(Luck)
    Info.Parent = Row

    local PickButton = Instance.new("TextButton")
    PickButton.Size = UDim2.new(0, 75, 0, 36)
    PickButton.Position = UDim2.new(1, -82, 0.5, -18)
    PickButton.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    PickButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    PickButton.TextSize = 12
    PickButton.Text = "🥚 NHẶT"
    PickButton.Parent = Row

    PickButton.MouseButton1Click:Connect(function()

        -- Tìm lại trứng hiện tại cùng loại
        local TargetEgg = nil

        for _, CurrentEgg in ipairs(ActiveEggs:GetChildren()) do

            local CurrentName = GetEggInfo(CurrentEgg)

            if CurrentName == EggName then
                TargetEgg = CurrentEgg
                break
            end

        end

        if TargetEgg then

            PickEgg(TargetEgg, PickButton)

        else

            PickButton.Text = "❌ HẾT TRỨNG"

            task.wait(1)

            PickButton.Text = "🥚 NHẶT"

        end

    end)

    EggRows[EggName] = Row

end

--========================================================
-- 15. REFRESH DANH SÁCH
--========================================================

local Refreshing = false

local function RefreshEggs()

    if Refreshing then
        return
    end

    Refreshing = true

    -- Xóa các dòng cũ
    for _, Child in ipairs(TakePage:GetChildren()) do

        if Child:IsA("Frame")
            and Child ~= TeleFrame then

            Child:Destroy()

        end
    end

    EggRows = {}

    -- Mỗi loại trứng chỉ xuất hiện 1 lần
    local EggTypes = {}

    for _, Egg in ipairs(ActiveEggs:GetChildren()) do

        local EggName = GetEggInfo(Egg)

        if EggName and not EggTypes[EggName] then
            EggTypes[EggName] = Egg
        end

    end

    for EggName, Egg in pairs(EggTypes) do
        CreateEggRow(Egg)
    end

    task.wait()

    TakePage.CanvasSize = UDim2.new(
        0,
        0,
        0,
        TakeLayout.AbsoluteContentSize.Y + 10
    )

    Refreshing = false

end

--========================================================
-- 16. TỰ CẬP NHẬT KHI TRỨNG THAY ĐỔI
--========================================================

ActiveEggs.ChildAdded:Connect(function()
    task.wait(0.1)
    RefreshEggs()
end)

ActiveEggs.ChildRemoved:Connect(function()
    task.wait(0.1)
    RefreshEggs()
end)

--========================================================
-- 17. CHUYỂN TAB
--========================================================

ViewEggButton.MouseButton1Click:Connect(function()

    if OldList then
        OldList.Visible = true
    end

    TakePage.Visible = false

end)

TakeEggButton.MouseButton1Click:Connect(function()

    if OldList then
        OldList.Visible = false
    end

    TakePage.Visible = true

    RefreshEggs()

end)

--========================================================
-- 18. KHỞI ĐỘNG
--========================================================

RefreshEggs()

-- Mặc định mở NHÌN TRỨNG
if OldList then
    OldList.Visible = true
end

TakePage.Visible = false

print("MINH ANH BÁ KHÍ + EGG MENU đã chạy")
