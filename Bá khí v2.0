--========================================================
-- MINH ANH BÁ KHÍ + EGG MENU
-- NHÌN TRỨNG + LẤY TRỨNG + TELE NHÀ + TELE CHỖ CŨ
--========================================================

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

--========================================================
-- 1. LOAD BÁ KHÍ GỐC
--========================================================

local BA_KHI_URL =
    "https://raw.githubusercontent.com/leminhanhdepzai2112013-collab/Script-/refs/heads/main/B%C3%A1%20kh%C3%AD"

pcall(function()
    loadstring(game:HttpGet(BA_KHI_URL))()
end)

-- Chờ GUI Bá Khí xuất hiện
local MainGui

for i = 1, 100 do
    MainGui = PlayerGui:FindFirstChild("MINH_ANH_BA_KHI")
    if MainGui then
        break
    end
    task.wait(0.1)
end

if not MainGui then
    warn("Không tìm thấy menu MINH_ANH_BA_KHI")
    return
end

local Main = MainGui:FindFirstChild("Main")

if not Main then
    warn("Không tìm thấy Main")
    return
end

--========================================================
-- 2. GAME DATA
--========================================================

local ServerData = ReplicatedStorage:WaitForChild("ServerData")
local ActiveEggs = ServerData:WaitForChild("ActiveEggs")

local EggsModule

pcall(function()
    EggsModule = require(
        ReplicatedStorage
            :WaitForChild("GameData")
            :WaitForChild("Eggs")
    )
end)

--========================================================
-- 3. NHÂN VẬT
--========================================================

local Character = Player.Character or Player.CharacterAdded:Wait()
local Root = Character:WaitForChild("HumanoidRootPart")

local SpawnCFrame = Root.CFrame
local OldPosition = nil

Player.CharacterAdded:Connect(function(NewCharacter)
    Character = NewCharacter

    local NewRoot = NewCharacter:WaitForChild("HumanoidRootPart")
    Root = NewRoot

    -- Chỉ lưu spawn lần đầu
    if not SpawnCFrame then
        SpawnCFrame = NewRoot.CFrame
    end
end)

--========================================================
-- 4. LẤY TÊN + LUCK CỦA TRỨNG
--========================================================

local function GetEggInfo(Egg)

    if not Egg then
        return "Trứng", 0
    end

    local EggName = Egg:GetAttribute("Egg")

    if not EggName then
        EggName = Egg.Name
    end

    local Luck = tonumber(Egg:GetAttribute("Luck")) or 0

    -- Lấy Luck từ GameData nếu có
    if EggsModule and EggName then
        pcall(function()

            local Data = EggsModule[EggName]

            if type(Data) == "table" then
                Luck = tonumber(Data.Luck) or Luck
            end

        end)
    end

    return EggName or "Trứng", Luck
end

--========================================================
-- 5. FORMAT SỐ
--========================================================

local function FormatNumber(Number)

    Number = tonumber(Number) or 0

    if Number >= 1000000000 then
        return string.format("%.1fB", Number / 1000000000)

    elseif Number >= 1000000 then
        return string.format("%.1fM", Number / 1000000)

    elseif Number >= 1000 then
        return string.format("%.1fK", Number / 1000)
    end

    return tostring(Number)
end

