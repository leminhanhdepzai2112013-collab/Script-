--========================================================
-- KÉO MA ĐỘC LẬP
--========================================================

local MADragging = false
local MADragStart
local MAStartPosition
local MADragMoved = false

MA.InputBegan:Connect(function(Input)

	if Input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or Input.UserInputType ==
		Enum.UserInputType.Touch then

		MADragging = true
		MADragMoved = false

		MADragStart =
			Input.Position

		MAStartPosition =
			MA.Position
	end
end)

UIS.InputChanged:Connect(function(Input)

	if not MADragging then
		return
	end

	if Input.UserInputType ==
		Enum.UserInputType.MouseMovement
		or Input.UserInputType ==
		Enum.UserInputType.Touch then

		local Delta =
			Input.Position - MADragStart

		if math.abs(Delta.X) > 5
			or math.abs(Delta.Y) > 5 then

			MADragMoved = true
		end

		MA.Position =
			UDim2.new(
				MAStartPosition.X.Scale,
				MAStartPosition.X.Offset + Delta.X,

				MAStartPosition.Y.Scale,
				MAStartPosition.Y.Offset + Delta.Y
			)
	end
end)

UIS.InputEnded:Connect(function(Input)

	if Input.UserInputType ==
		Enum.UserInputType.MouseButton1
		or Input.UserInputType ==
		Enum.UserInputType.Touch then

		MADragging = false
	end
end)

