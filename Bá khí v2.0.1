local function CreateEggRow(Egg)

    if not Egg
        or not Egg.Parent then

        return

    end

    local EggName,Luck =
        GetEggInfo(Egg)

    if not EggName then
        return
    end

    -- Không tạo trùng loại
    for ExistingEgg,Data in pairs(
        EggRows
    ) do

        if ExistingEgg
            and ExistingEgg.Parent then

            local ExistingName =
                ExistingEgg:GetAttribute(
                    "Egg"
                )

            if ExistingName
                == EggName then

                return

            end

        end

    end

    --====================================================
    -- ROW
    --====================================================

    local Row =
        Instance.new("Frame")

    Row.Name =
        "Egg_"
        .. tostring(EggName)

    Row.Size =
        UDim2.new(1,-5,0,58)

    Row.BackgroundColor3 =
        Color3.fromRGB(
            40,30,65
        )

    Row.BorderSizePixel = 0

    Row.Parent =
        TakePage

    local Corner =
        Instance.new("UICorner")

    Corner.CornerRadius =
        UDim.new(0,9)

    Corner.Parent = Row

    --====================================================
    -- THÔNG TIN
    --====================================================

    local Info =
        Instance.new("TextLabel")

    Info.BackgroundTransparency = 1

    Info.Position =
        UDim2.new(0,10,0,4)

    Info.Size =
        UDim2.new(1,-88,1,-8)

    Info.Text =
        "🥚 "
        .. tostring(EggName)
        .. "\n🍀 Luck: "
        .. FormatNumber(Luck)

    Info.TextColor3 =
        Color3.new(1,1,1)

    Info.Font =
        Enum.Font.GothamBold

    Info.TextSize = 11

    Info.TextXAlignment =
        Enum.TextXAlignment.Left

    Info.TextYAlignment =
        Enum.TextYAlignment.Center

    Info.Parent = Row

    --====================================================
    -- NÚT NHẶT
    --====================================================

    local Button =
        Instance.new("TextButton")

    Button.Size =
        UDim2.new(0,68,0,34)

    Button.Position =
        UDim2.new(
            1,-74,
            0.5,-17
        )

    Button.BackgroundColor3 =
        Color3.fromRGB(
            100,55,190
        )

    Button.BorderSizePixel = 0

    Button.Text =
        "🥚 NHẶT"

    Button.TextColor3 =
        Color3.new(1,1,1)

    Button.Font =
        Enum.Font.GothamBold

    Button.TextSize = 10

    Button.Parent = Row

    local ButtonCorner =
        Instance.new("UICorner")

    ButtonCorner.CornerRadius =
        UDim.new(0,8)

    ButtonCorner.Parent =
        Button

    EggRows[Egg] = {

        Row = Row,

        Button = Button,

        EggName = EggName

    }

    --====================================================
    -- BẤM NHẶT
    --====================================================

    Button.Activated:Connect(function()

        if Busy then
            return
        end

        local TargetEgg

        -- Tìm lại trứng cùng loại
        for _,CurrentEgg in ipairs(
            ActiveEggs:GetChildren()
        ) do

            local CurrentName =
                CurrentEgg:GetAttribute(
                    "Egg"
                )

            if CurrentName
                == EggName then

                TargetEgg =
                    CurrentEgg

                break

            end

        end

        if not TargetEgg then

            Button.Text =
                "❌ KHÔNG CÒN"

            task.wait(0.5)

            RefreshEggs()

            return

        end

        PickEgg(
            TargetEgg,
            Button
        )

    end)

end

--========================================================
-- REFRESH
-- MỖI LOẠI TRỨNG CHỈ 1 DÒNG
--========================================================

function RefreshEggs()

    -- Xóa danh sách cũ
    for Egg,Data in pairs(
        EggRows
    ) do

        if Data.Row then
            Data.Row:Destroy()
        end

    end

    EggRows = {}

    --====================================================
    -- LẤY 1 ĐẠI DIỆN CHO MỖI LOẠI
    --====================================================

    local EggTypes = {}

    for _,Egg in ipairs(
        ActiveEggs:GetChildren()
    ) do

        local EggName =
            Egg:GetAttribute(
                "Egg"
            )

        if EggName
            and not EggTypes[EggName] then

            EggTypes[EggName] =
                Egg

        end

    end

    --====================================================
    -- TẠO MENU
    --====================================================

    for _,Egg in pairs(
        EggTypes
    ) do

        CreateEggRow(Egg)

    end

    task.defer(function()

        TakePage.CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                TakeLayout
                    .AbsoluteContentSize
                    .Y
                + 10
            )

    end)

end

