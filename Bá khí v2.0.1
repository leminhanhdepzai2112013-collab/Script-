--========================================================
-- TÌM PROMPT
--========================================================

local function FindPrompt(Egg)

    if not Egg
        or not Egg.Parent then

        return nil

    end

    local Prompt =
        Egg:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if Prompt then
        return Prompt
    end

    local Position =
        Egg:GetAttribute("Position")

    if typeof(Position) ~= "Vector3" then
        return nil
    end

    for _,Object in ipairs(
        workspace:GetDescendants()
    ) do

        if Object:IsA(
            "ProximityPrompt"
        ) then

            local Parent =
                Object.Parent

            if Parent
                and Parent:IsA(
                    "BasePart"
                ) then

                if (
                    Parent.Position
                    - Position
                ).Magnitude <= 8 then

                    return Object

                end

            end

        end

    end

    return nil

end

--========================================================
-- NHẶT TRỨNG
-- TELE TỚI TRỨNG
-- NHẶT
-- QUAY VỀ CHỖ ĐÃ ĐẶT
--========================================================
local function PickEgg(Egg, Button)

    if Busy then return end

    if not EggPickupPosition then
        Button.Text = "⚠ CHƯA ĐẶT VỊ TRÍ"
        task.wait(1)
        if Button.Parent then Button.Text = "🥚 NHẶT" end
        return
    end

    if not Egg or not Egg.Parent then
        Button.Text = "❌ KHÔNG CÒN"
        task.wait(0.6)
        if Button.Parent then Button.Text = "🥚 NHẶT" end
        return
    end

    local Root = GetRoot()
    if not Root then return end

    local Position = Egg:GetAttribute("Position")
    if typeof(Position) ~= "Vector3" then
        Button.Text = "❌ KHÔNG CÓ VỊ TRÍ"
        task.wait(0.7)
        if Button.Parent then Button.Text = "🥚 NHẶT" end
        return
    end

    Busy = true
    local ReturnCFrame = EggPickupPosition

    --================ BAY TỚI TRỨNG ================
    Button.Text = "🚀 ĐANG BAY TỚI TRỨNG..."

    local ok1 = pcall(function()
        FlyTo(Root, Position, 3)
        -- áp sát trứng để đủ tầm nhặt
        Root.CFrame = CFrame.new(Position + Vector3.new(0,3,0))
    end)
    Root.Anchored = false

    if not ok1 then
        Busy = false
        Button.Text = "❌ LỖI BAY"
        task.wait(0.7)
        if Button.Parent then Button.Text = "🥚 NHẶT" end
        return
    end

    task.wait(0.3)

    --================ NHẶT ================
    local Prompt = FindPrompt(Egg)

    if Prompt then
        Button.Text = "🥚 ĐANG NHẶT..."

        if typeof(fireproximityprompt) == "function" then
            pcall(function() fireproximityprompt(Prompt) end)
        else
            pcall(function()
                Prompt:InputHoldBegin()
                task.wait(math.max(Prompt.HoldDuration, 0.15))
                Prompt:InputHoldEnd()
            end)
        end

        task.wait(0.7)
    else
        Button.Text = "⚠ KHÔNG CÓ PROMPT"
        task.wait(0.5)
    end

    --================ BAY VỀ ================
    if Root and Root.Parent then
        Button.Text = "↩ ĐANG BAY VỀ..."

        pcall(function()
            FlyTo(Root, ReturnCFrame.Position, 3)
            Root.CFrame = ReturnCFrame
        end)
        Root.Anchored = false

        if Prompt then
            Button.Text = "✅ THÀNH CÔNG"
        end
    end

    Busy = false
    task.wait(0.7)
    if Button and Button.Parent then
        Button.Text = "🥚 NHẶT"
    end
end
