-- RAYCAST
local function BuildParams()
    local list = {}
    for _,p in ipairs(Players:GetPlayers()) do
        if p.Character then table.insert(list, p.Character) end
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = list
    params.RespectCanCollide = true
    return params
end

-- Hướng bay có thông thoáng không (quét 3 tia ngang x 2 độ cao)
local function IsClear(params, pos, dir, dist)
    local right = Vector3.new(-dir.Z, 0, dir.X)
    for _,side in ipairs({0, 2, -2}) do
        for _,h in ipairs({-1, 1.5}) do
            local origin = pos + right * side + Vector3.new(0, h, 0)
            if workspace:Raycast(origin, dir * dist, params) then
                return false
            end
        end
    end
    return true
end

-- BAY TỚI Target (Vector3), dừng khi cách StopDistance (theo mặt phẳng ngang)
local function FlyTo(Root, Target, StopDistance)
    local params = BuildParams()
    local pos = Root.Position
    local side = 1
    local startTime = os.clock()

    Root.Anchored = true

    while Root.Parent and os.clock() - startTime < 90 do
        local dt = RunService.Heartbeat:Wait()

        local flat = Vector3.new(Target.X - pos.X, 0, Target.Z - pos.Z)
        local dist = flat.Magnitude
        if dist <= StopDistance then break end

        local step = math.min(FlySpeed * dt, dist)
        local want = flat.Unit
        local look = math.max(8, FlySpeed * 0.3)

        -- tìm hướng thông thoáng: thẳng -> lệch dần 25° mỗi bước
        local chosen
        for _,angle in ipairs({0, 25, 50, 75, 100, 130}) do
            for _,s in ipairs(angle == 0 and {1} or {side, -side}) do
                local dir = CFrame.Angles(0, math.rad(angle * s), 0)
                    :VectorToWorldSpace(want)
                if IsClear(params, pos, dir, look) then
                    chosen = dir
                    if angle ~= 0 then side = s end
                    break
                end
            end
            if chosen then break end
        end

        if chosen then
            local nx = pos.X + chosen.X * step
            local nz = pos.Z + chosen.Z * step

            -- bám đất: bắn tia xuống từ cao hơn Root một chút
            local y = pos.Y
            local hit = workspace:Raycast(
                Vector3.new(nx, pos.Y + 5, nz),
                Vector3.new(0, -1000, 0),
                params
            )
            if hit then
                local goal = hit.Position.Y + GroundOffset
                y = pos.Y + (goal - pos.Y) * math.min(1, dt * 10)
            end

            pos = Vector3.new(nx, y, nz)
            Root.CFrame = CFrame.lookAt(pos, pos + chosen)
        else
            -- bị chặn kín mọi hướng: bay vọt lên qua vật cản
            pos = pos + Vector3.new(0, step, 0)
            Root.CFrame = CFrame.new(pos)
        end

        Root.AssemblyLinearVelocity = Vector3.zero
    end
end
