            100,55,190
        )

    TakeButton.BackgroundColor3 =
        Color3.fromRGB(
            45,35,75
        )

end)

--========================================================
-- TAB LẤY
--========================================================

TakeButton.Activated:Connect(function()

    OldList.Visible = false

    TakePage.Visible = true

    SeeButton.BackgroundColor3 =
        Color3.fromRGB(
            45,35,75
        )

    TakeButton.BackgroundColor3 =
        Color3.fromRGB(
            100,55,190
        )

    RefreshEggs()

end)

--========================================================
-- TRỨNG THÊM
--========================================================

ActiveEggs.ChildAdded:Connect(function()

    task.wait(0.1)

    RefreshEggs()

end)

--========================================================
-- TRỨNG XÓA
--========================================================

ActiveEggs.ChildRemoved:Connect(function()

    task.wait(0.1)

    RefreshEggs()

end)

