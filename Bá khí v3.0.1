--========================================================
-- PHAN 2: BAY VE NHA, TU CHINH TOC DO, NE VAT CAN
--========================================================
local function BuildFly()
    local ZERO = Vector3.new(0, 0, 0)
    local UP = Vector3.new(0, 1, 0)

    local function MakeParams()
        local p = RaycastParams.new()
        local ok = pcall(function() p.FilterType = Enum.RaycastFilterType.Exclude end)
        if not ok then p.FilterType = Enum.RaycastFilterType.Blacklist end
        p.FilterDescendantsInstances = {Player.Character}
        pcall(function() p.RespectCanCollide = true end)
        return p
    end

    local function PathClear(Pos, Dir, Dist, Params)
        local right = Dir:Cross(UP)
        if right.Magnitude < 0.01 then return true end
        right = right.Unit
        local offsets = {
            ZERO, right * 1.8, -right * 1.8,
            Vector3.new(0, 2.5, 0), Vector3.new(0, -2, 0),
        }
        for _, o in ipairs(offsets) do
            if workspace:Raycast(Pos + o, Dir * Dist, Params) then
                return false
            end
        end
        return true
    end

    -- Deadline: moc os.clock() can ve toi nha. Tra ve true neu toi noi.
    function D.FlyHome(Root, Hum, Target, OnStatus, Deadline)
        local Params = MakeParams()
        local RootOffset = (Hum and Hum.HipHeight or 2) + Root.Size.Y / 2

        local lastCheck, lastPos, lastStatus = os.clock(), Root.Position, 0
        local extra, side, stuck = 0, 1, 0
        local arrived = false

        local oldPlatform = Hum and Hum.PlatformStand
        if Hum then Hum.PlatformStand = true end

        local ok, err = pcall(function()
            while true do
                local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
                if D.Cancel or not Root.Parent then break end

                local pos = Root.Position
                local flatVec = Vector3.new(Target.X - pos.X, 0, Target.Z - pos.Z)
                local flatDist = flatVec.Magnitude

                if flatDist < 3 and math.abs(pos.Y - Target.Y) < 4 then
                    arrived = true
                    break
                end

                -- toc do tu tinh theo quang duong va thoi gian con lai
                local Speed = S.Speed
                local remainT = nil
                if S.AutoSpeed and Deadline then
                    remainT = Deadline - os.clock()
                    if remainT > 0.5 then
                        local need = flatDist * 1.3 + 15
                        Speed = math.clamp(need / (remainT * 0.8), S.MinSpeed, S.Speed)
                    end
                end

                local want = ZERO
                if flatDist > 0.01 then want = flatVec / flatDist end

                local dir = want
                if stuck >= 2 and flatDist > 3 then
                    dir = CFrame.Angles(0, math.rad(50 * side), 0):VectorToWorldSpace(want)
                end

                -- quet be mat cao nhat phia truoc
                local L = 14 + Speed * 0.3
                local right = dir:Cross(UP)
                if right.Magnitude > 0.01 then
                    right = right.Unit
                else
                    right = Vector3.new(1, 0, 0)
                end

                local startY = pos.Y + 60 + extra
                local highest = nil
                local dists = {0, L * 0.33, L * 0.66, L}
                local lats = {-2, 0, 2}
                for _, d in ipairs(dists) do
                    local dd = math.min(d, flatDist)
                    for _, l in ipairs(lats) do
                        local p = pos + dir * dd + right * l
                        local r = workspace:Raycast(
                            Vector3.new(p.X, startY, p.Z),
                            Vector3.new(0, -400, 0),
                            Params
                        )
                        if r and (not highest or r.Position.Y > highest) then
                            highest = r.Position.Y
                        end
                    end
                end

                -- bi chan ngang -> bay len, khong tien
                local blocked = false
                if flatDist >= 14 then
                    local reach = math.min(Speed * dt, flatDist) + 5 + Speed * 0.1
                    blocked = not PathClear(pos, dir, reach, Params)
                end

                if blocked then
                    extra = math.min(extra + math.max(Speed * 0.8, 60) * dt, 400)
                else
                    extra = math.max(0, extra - 40 * dt)
                end

                local targetY = pos.Y
                if highest then
                    targetY = highest + RootOffset + S.Hover + extra
                end
                if flatDist < 14 then targetY = Target.Y end

                local up = math.max(Speed * 1.2, 90) * dt
                local down = math.max(Speed * 0.6, 40) * dt
                local dy = math.clamp(targetY - pos.Y, -down, up)

                local horiz = ZERO
                if not blocked then
                    local step = math.min(Speed * dt, flatDist)
                    if targetY - pos.Y > 6 and flatDist >= 14 then
                        step = step * 0.3
                    end
                    horiz = dir * step
                end

                local newPos = pos + horiz + Vector3.new(0, dy, 0)

                local faceDir = Vector3.new(dir.X, 0, dir.Z)
                if faceDir.Magnitude < 0.01 then faceDir = want end

                if faceDir.Magnitude > 0.01 then
                    Root.CFrame = CFrame.new(newPos, newPos + faceDir)
                else
                    Root.CFrame = CFrame.new(newPos)
                end
                Root.AssemblyLinearVelocity = ZERO
                Root.AssemblyAngularVelocity = ZERO

                -- ket: tang do cao va doi ben ne (khong tele)
                if os.clock() - lastCheck >= 1 then
                    if (Root.Position - lastPos).Magnitude < 3 then
                        stuck = stuck + 1
                        extra = math.min(extra + 15, 400)
                        side = -side
                    else
                        stuck = 0
                    end
                    lastCheck, lastPos = os.clock(), Root.Position
                end

                if OnStatus and os.clock() - lastStatus > 0.2 then
                    lastStatus = os.clock()
                    OnStatus(flatDist, blocked or (targetY - pos.Y > 6), Speed, remainT)
                end
            end
        end)

        if not ok then warn("LOI BAY VE:", err) end

        if Hum then Hum.PlatformStand = oldPlatform or false end
        if Root and Root.Parent then Root.AssemblyLinearVelocity = ZERO end

        return arrived
    end

    return true
end

