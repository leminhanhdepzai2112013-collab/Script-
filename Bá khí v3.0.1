-- BAY: TU CHON "BAY QUA DAU" / "DI TRONG ME CUNG" / "BAY THANG"
--========================================================
local function BuildFly()
    local ZERO = Vector3.new(0, 0, 0)
    local YAXIS = Vector3.new(0, 1, 0)

    -- opts: Deadline, OnStatus(dist, climbing, speed, remainT), Maze (ep di tim loi vao)
    -- tra ve true neu toi noi
    function D.FlyTo(Root, Hum, Target, opts)
        opts = opts or {}
        local Nav = D.Nav
        local OnStatus = opts.OnStatus
        local Deadline = opts.Deadline
        local memory = {Visits = {}, Bad = {}}
        if Nav then Nav.Small = {} end

        local RootOffset = (Hum and Hum.HipHeight or 2) + Root.Size.Y / 2
        local curCF = Root.CFrame
        local arrived = false

        local oldPlatform = Hum and Hum.PlatformStand
        if Hum then Hum.PlatformStand = true end

        -- nhuong 1 khung hinh nhung giu nguyen vi tri (dung khi dang lap duong)
        local function hold()
            local dt = RunService.Heartbeat:Wait()
            if Root.Parent then
                Root.CFrame = curCF
                Root.AssemblyLinearVelocity = ZERO
                Root.AssemblyAngularVelocity = ZERO
            end
            return dt
        end

        local mode = "direct"
        local goalRoofed = false
        if Nav then
            local startRoofed = Nav.Roofed(Root.Position)
            goalRoofed = Nav.Roofed(Target)
            if opts.Maze or startRoofed or goalRoofed then
                mode = "maze"
            else
                mode = "over"
            end
        end

        local path, pidx, cum, partialPath = nil, 1, nil, false
        local needReplan = true
        local failCount = 0

        local function Replan()
            local pos = Root.Position
            local level = Target.Y
            if Nav.Roofed(pos) and not goalRoofed then level = pos.Y end
            local p, partial = Nav.Plan(pos, Target, level, hold, memory)
            if not p then return false end
            path, pidx, partialPath = p, 1, partial
            cum = {}
            cum[#p] = 0
            for i = #p - 1, 1, -1 do
                cum[i] = cum[i + 1] + (p[i + 1] - p[i]).Magnitude
            end
            return true
        end

        local startTime = os.clock()
        local lastCheck, lastPos = os.clock(), Root.Position
        local lastStatus, lastVisit = 0, 0
        local extra, stuck, blockedT = 0, 0, 0

        local ok, err = pcall(function()
            while true do
                local dt = math.min(RunService.Heartbeat:Wait(), 0.1)
                if D.Cancel or not Root.Parent then break end

                local pos = Root.Position
                local flatVec = Vector3.new(Target.X - pos.X, 0, Target.Z - pos.Z)
                local flatDist = flatVec.Magnitude

                if flatDist < 3 and math.abs(pos.Y - Target.Y) < 4 then
                    arrived = true
                    break
                end

                -- qua lau thi bay thang cho chac chan toi noi
                if mode ~= "direct" and os.clock() - startTime > 90 then
                    mode = "direct"
                end

                -- lap duong khi can (me cung)
                if mode == "maze" and (needReplan or not path
                    or (path[pidx] == nil and partialPath)) then
                    local okp = Replan()
                    needReplan = false
                    if not okp then
                        failCount = failCount + 1
                        if failCount >= 2 then mode = "direct" end
                    end
                    pos = Root.Position
                    flatVec = Vector3.new(Target.X - pos.X, 0, Target.Z - pos.Z)
                    flatDist = flatVec.Magnitude
                    dt = 1 / 60
                    lastCheck, lastPos = os.clock(), pos
                end

                -- quang duong con lai (de tu chinh toc do)
                local remLen = flatDist
                if mode == "maze" and path and path[pidx] then
                    remLen = (path[pidx] - pos).Magnitude + cum[pidx]
                end

                local Speed = S.Speed
                local remainT = nil
                if S.AutoSpeed and Deadline then
                    remainT = Deadline - os.clock()
                    if remainT > 0.5 then
                        Speed = math.clamp(
                            (remLen * 1.1 + 10) / (remainT * 0.8),
                            S.MinSpeed, S.Speed
                        )
                    end
                end

                local newPos = pos
                local climbing = false

                if mode == "maze" and path then
                    ------------------------------------------------
                    -- DI THEO DUONG DA LAP (co mang du de khong ngo cut)
                    ------------------------------------------------
                    local p = pos
                    local budget = Speed * dt
                    local guard = 0
                    while budget > 0 and path[pidx] and guard < 12 do
                        guard = guard + 1
                        local w = path[pidx]
                        local d = w - p
                        local dd = d.Magnitude
                        if dd <= budget then
                            p = w
                            budget = budget - dd
                            pidx = pidx + 1
                        else
                            p = p + d.Unit * budget
                            budget = 0
                        end
                    end
                    newPos = p
                    if math.abs(newPos.Y - pos.Y) > 3 then climbing = true end

                elseif mode == "over" then
                    ------------------------------------------------
                    -- BAY QUA DAU: chi tinh vat lon, vat nho bay xuyen
                    ------------------------------------------------
                    local want = ZERO
                    if flatDist > 0.01 then want = flatVec / flatDist end

                    local L = math.min(14 + Speed * 0.3, 250)
                    local topY = math.max(pos.Y, Target.Y) + 80 + extra
                    local highest = nil
                    for _, f in ipairs({0, 0.5, 1}) do
                        local dd = math.min(L * f, flatDist)
                        local r = Nav.CastBig(
                            Vector3.new(pos.X + want.X * dd, topY, pos.Z + want.Z * dd),
                            Vector3.new(0, -700, 0)
                        )
                        if r and (not highest or r.Position.Y > highest) then
                            highest = r.Position.Y
                        end
                    end

                    local blockedAhead = false
                    if flatDist >= 14 then
                        local reach = math.min(Speed * dt, flatDist) + 5 + Speed * 0.1
                        local right = want:Cross(YAXIS)
                        if right.Magnitude > 0.01 then
                            right = right.Unit
                        else
                            right = Vector3.new(1, 0, 0)
                        end
                        for _, o in ipairs({ZERO, right * 1.8, -right * 1.8, Vector3.new(0, 2.5, 0)}) do
                            if Nav.CastBig(pos + o, want * reach) then
                                blockedAhead = true
                                break
                            end
                        end
                    end

                    if blockedAhead then
                        blockedT = blockedT + dt
                        extra = math.min(extra + math.max(Speed * 0.8, 60) * dt, 300)
                        climbing = true
                        if blockedT > 1.2 then
                            mode = "maze" -- bay len khong duoc: chuyen sang tim duong
                            needReplan = true
                            extra = 0
                            blockedT = 0
                        end
                    else
                        blockedT = 0
                        extra = math.max(0, extra - 40 * dt)
                    end

                    local targetY = pos.Y
                    if highest then
                        targetY = highest + RootOffset + S.Hover + extra
                    end
                    if flatDist < 14 then targetY = Target.Y end

                    local up = math.max(Speed * 1.2, 90) * dt
                    local down = math.max(Speed * 0.6, 40) * dt
                    local dy = math.clamp(targetY - pos.Y, -down, up)

                    local horiz = ZERO
                    if not blockedAhead then
                        local step = math.min(Speed * dt, flatDist)
                        if targetY - pos.Y > 6 and flatDist >= 14 then
                            step = step * 0.3
                        end
                        horiz = want * step
                    end
                    if targetY - pos.Y > 6 then climbing = true end
                    newPos = pos + horiz + Vector3.new(0, dy, 0)

                else
                    ------------------------------------------------
                    -- BAY THANG (phuong an cuoi cung, dam bao toi noi)
                    ------------------------------------------------
                    local d = Target - pos
                    local dd = d.Magnitude
                    if dd > 0.01 then
                        newPos = pos + d.Unit * math.min(Speed * dt, dd)
                    end
                end

                local mv = Vector3.new(newPos.X - pos.X, 0, newPos.Z - pos.Z)
                local cf
                if mv.Magnitude > 0.01 then
                    cf = CFrame.new(newPos, newPos + mv)
                else
                    local rot = Root.CFrame - Root.CFrame.Position
                    cf = CFrame.new(newPos) * rot
                end
                Root.CFrame = cf
                curCF = cf
                Root.AssemblyLinearVelocity = ZERO
                Root.AssemblyAngularVelocity = ZERO

                -- nho cho da di qua (de lan sau tranh quanh quan)
                if mode == "maze" and os.clock() - lastVisit > 0.3 then
                    lastVisit = os.clock()
                    local kk = Nav.WK(pos.X, pos.Z)
                    memory.Visits[kk] = (memory.Visits[kk] or 0) + 1
                end

                -- phat hien ket: danh dau o phia truoc la xau, lap duong lai
                if os.clock() - lastCheck >= 0.7 then
                    local moved = (Root.Position - lastPos).Magnitude
                    if mode ~= "direct" and moved < math.max(2, Speed * 0.12) then
                        stuck = stuck + 1
                        if mode == "maze" then
                            local ahead = pos
                            if path and path[pidx] then
                                local dv = path[pidx] - pos
                                if dv.Magnitude > 0.5 then ahead = pos + dv.Unit * 4 end
                            end
                            memory.Bad[Nav.WK(ahead.X, ahead.Z)] = true
                            needReplan = true
                        else
                            extra = math.min(extra + 15, 300)
                            if stuck >= 2 and Nav then
                                mode = "maze"
                                needReplan = true
                            end
                        end
                        if stuck >= 6 then mode = "direct" end
                    else
                        stuck = 0
                    end
                    lastCheck, lastPos = os.clock(), Root.Position
                end

                if OnStatus and os.clock() - lastStatus > 0.2 then
                    lastStatus = os.clock()
                    OnStatus(remLen, climbing, Speed, remainT)
                end
            end
        end)

        if not ok then warn("LOI BAY:", err) end

        if Hum then Hum.PlatformStand = oldPlatform or false end
        if Root and Root.Parent then Root.AssemblyLinearVelocity = ZERO end

        return arrived
    end

    -- ten cu, de cac phan khac van goi duoc
    function D.FlyHome(Root, Hum, Target, OnStatus, Deadline)
        return D.FlyTo(Root, Hum, Target, {OnStatus = OnStatus, Deadline = Deadline})
    end

    return true
end
