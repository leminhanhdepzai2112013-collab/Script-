        for _, c in ipairs(Containers()) do
            local old = c:FindFirstChild("MA_STATUS_GUI")
            if old then old:Destroy() end
        end

        local multi = string.find(msg, "\n", 1, true) ~= nil
        local compact = (not isError) and (not multi)

        local accent = Color3.fromRGB(70, 210, 130)
        if isError then
            accent = Color3.fromRGB(235, 80, 95)
        elseif multi then
            accent = Color3.fromRGB(130, 90, 230)
        end

        local sg = Instance.new("ScreenGui")
        sg.Name = "MA_STATUS_GUI"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 999

