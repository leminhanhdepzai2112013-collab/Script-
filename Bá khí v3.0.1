local Failed = {}

local function Run(name, fn)
    local ok, res = xpcall(fn, function(e)
        local tb = ""
        pcall(function() tb = debug.traceback() end)
        return tostring(e) .. "\n" .. tostring(tb)
    end)
    if not ok then
        table.insert(Failed, name .. ": " .. tostring(res))
        return false
    end
    return true
end

Run("Dò đường", BuildNav)
Run("Bay", BuildFly)
local uiOk = Run("Giao diện", BuildUI)
if uiOk then
    Run("Thú cưng", BuildPet)
    Run("Nhặt trứng", BuildEggs)
end

if #Failed == 0 then
    D.Status("Tải thành công", false, 3)
else
    D.Status("Có lỗi khi tải:\n" .. table.concat(Failed, "\n"), true)
end
