            bar.Position = UDim2.new(0, 8, 0, 8)
            bar.BackgroundColor3 = accent
            bar.BorderSizePixel = 0
            bar.Parent = card
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(1, 0)
            bc.Parent = bar

            local box = Instance.new("TextBox")
            box.Position = UDim2.new(0, 20, 0, 6)
            box.Size = UDim2.new(1, -56, 1, -12)
            box.BackgroundTransparency = 1
            box.TextColor3 = Color3.fromRGB(235, 235, 245)
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.TextWrapped = true
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.TextYAlignment = Enum.TextYAlignment.Top
            box.MultiLine = true
            box.ClearTextOnFocus = false
            box.Text = msg
            box.Parent = card

            local close = Instance.new("TextButton")
            close.Size = UDim2.new(0, 24, 0, 24)
            close.Position = UDim2.new(1, -30, 0, 6)
            close.BackgroundColor3 = Color3.fromRGB(45, 38, 70)
            close.BorderSizePixel = 0
            close.Text = "X"
            close.TextColor3 = Color3.fromRGB(235, 235, 245)
            close.Font = Enum.Font.GothamBold
            close.TextSize = 11
            close.Parent = card
            local cc = Instance.new("UICorner")
            cc.CornerRadius = UDim.new(0, 6)
            cc.Parent = close
            close.Activated:Connect(function() sg:Destroy() end)
        end

        sg.Parent = Containers()[1]

