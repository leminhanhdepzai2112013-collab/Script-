local function BuildUI()
    for _, v in ipairs(GUI:GetDescendants()) do
        if v.Name == "MA_EGG_TABS" or v.Name == "MA_TAKE_EGG_PAGE" then
            v:Destroy()
        end
    end

    -- tim khung chinh va danh sach goc
    local Main, OldList
    for _, v in ipairs(GUI:GetChildren()) do
        if v:IsA("Frame") then
            for _, c in ipairs(v:GetChildren()) do
                if c:IsA("ScrollingFrame") then
                    Main, OldList = v, c
                    break
                end
            end
            if OldList then break end
        end
    end
    if not OldList then
        for _, v in ipairs(GUI:GetDescendants()) do
            if v:IsA("ScrollingFrame") then
                OldList = v
                Main = v.Parent
                break
            end
        end
    end
    if not Main or not OldList then
        error("không tìm thấy khung/danh sách trong menu gốc")
    end

    local ServerData = RS:WaitForChild("ServerData", 10)
    local ActiveEggs = ServerData and ServerData:WaitForChild("ActiveEggs", 10)
