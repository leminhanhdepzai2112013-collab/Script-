local Before = {}
for _, c in ipairs(Containers()) do
    for _, g in ipairs(c:GetChildren()) do
        Before[g] = true
    end
end

local Loaded, LoadFailed = false, false

task.spawn(function()
    local ok, err = pcall(function()
        loadstring(game:HttpGet(URL))()
    end)
    if not ok then
        LoadFailed = true
        D.Status("Không tải được script gốc: " .. tostring(err), true)
    end
    Loaded = true
end)

local function FindGui()
    for _, c in ipairs(Containers()) do
        local g = c:FindFirstChild(GUI_NAME)
        if g then return g end
    end
    for _, c in ipairs(Containers()) do
        for _, g in ipairs(c:GetChildren()) do
            if g:IsA("ScreenGui") and not Before[g]
                and g.Name ~= "MA_STATUS_GUI"
                and g:FindFirstChildWhichIsA("ScrollingFrame", true) then
                return g
            end
        end
    end
end

local GUI
for _ = 1, 40 do
    GUI = FindGui()
    if GUI then break end
    task.wait(0.5)
end

if not GUI then
    D.Status("Phần 1 LỖI: không thấy menu của script gốc", true)
    return
end

if LoadFailed then return end

local t0 = os.clock()
while not Loaded and os.clock() - t0 < 5 do task.wait(0.1) end
task.wait(0.5)

D.GUI = GUI

