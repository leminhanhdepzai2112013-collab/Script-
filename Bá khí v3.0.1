-- THU CUNG XIN NHAT + THOI GIAN TRUNG
--========================================================
local function BuildPet()
    local TIME_WORDS = {
        "expire", "despawn", "lifetime", "timeleft", "remain", "timer",
        "duration", "endtime", "deadline", "ttl", "time", "left", "end",
    }

    local function ServerNow()
        local ok, t = pcall(function() return workspace:GetServerTimeNow() end)
        if ok and t then return t end
        return os.time()
    end

    function D.GetRemaining(Egg)
        if not Egg then return nil end
        local now = ServerNow()
        local bestRem

        for name, val in pairs(Egg:GetAttributes()) do
            if type(val) == "number" then
                local l = string.lower(name)
                local isTime = false
                for _, w in ipairs(TIME_WORDS) do
                    if string.find(l, w, 1, true) then
                        isTime = true
                        break
                    end
                end
                if isTime then
                    local rem = nil
                    if val > 1e11 then
                        rem = val / 1000 - now
                    elseif val > 1e8 then
                        rem = val - now
                    elseif val > 0 and val <= 7200 then
                        if string.find(l, "left", 1, true)
                            or string.find(l, "remain", 1, true) then
                            rem = val
                        end
                    end
                    if rem and rem > 0 and rem < 86400 then
                        if not bestRem or rem < bestRem then bestRem = rem end
                    end
                end
            end
        end

        return bestRem
    end

    local SUFFIX = {k = 1e3, m = 1e6, b = 1e9, t = 1e12}

    local function PetScore(tool)
        local l = string.lower(tool.Name)
        local score = 0

        -- ten dang "Dog [337.35 KG] [Age 5]"
        local num, suf = string.match(l, "([%d%.,]+)%s*([kmbt]?)%s*kg")
        if num then
            num = string.gsub(num, ",", "")
            local n = tonumber(num)
            if n then score = n * (SUFFIX[suf] or 1) end
        end

        for k, v in pairs(tool:GetAttributes()) do
            if type(v) == "number" then
                local kl = string.lower(k)
                if string.find(kl, "weight", 1, true)
                    or string.find(kl, "kg", 1, true)
                    or string.find(kl, "mass", 1, true)
                    or string.find(kl, "size", 1, true) then
                    if v > score then score = v end
                end
            end
        end

        local age = tonumber(string.match(l, "age%s*(%d+)")) or 0
        return score + age * 1e-6
    end

    local function IsPetTool(t)
        if not t:IsA("Tool") then return false end
        local l = string.lower(t.Name)
        return string.find(l, "kg", 1, true) ~= nil
            or string.find(l, "pet", 1, true) ~= nil
            or string.find(l, "%[") ~= nil
    end

    local function FindBestPet()
        local best, bestScore = nil, -1
        local places = {Player:FindFirstChild("Backpack"), Player.Character}
        for _, place in ipairs(places) do
            if place then
                for _, t in ipairs(place:GetChildren()) do
                    if IsPetTool(t) then
                        local sc = PetScore(t)
                        if sc > bestScore then best, bestScore = t, sc end
                    end
                end
            end
        end
        return best
    end

    local RIDE_WORDS = {"ride", "mount", "saddle", "cuoi", "riding"}

    local function FindRideRemotes()
        local list = {}
        for _, v in ipairs(RS:GetDescendants()) do
            if v:IsA("RemoteEvent") or v:IsA("RemoteFunction") then
                local l = string.lower(v.Name)
                for _, w in ipairs(RIDE_WORDS) do
                    if string.find(l, w, 1, true) then
                        table.insert(list, v)
                        break
                    end
                end
            end
        end
        return list
    end

    D.RideNote = ""

    function D.TryRide()
        D.RideNote = ""
        local Root, Hum = GetChar()
        if not Hum then
            D.RideNote = "không thấy nhân vật"
            return false
        end

        local Pet = FindBestPet()
        if not Pet then
            D.RideNote = "không thấy thú cưng trong túi"
            return false
        end

        if Pet.Parent ~= Player.Character then
            pcall(function() Hum:EquipTool(Pet) end)
            task.wait(0.3)
        end

        for _, r in ipairs(FindRideRemotes()) do
            task.spawn(function()
                pcall(function()
                    if r:IsA("RemoteEvent") then
                        r:FireServer(Pet)
                    else
                        r:InvokeServer(Pet)
                    end
                end)
            end)
        end
        task.wait(0.4)

        D.RideNote = "đã chọn " .. Pet.Name
        return true
    end

    return true
end
--========================================================
-- NHAT TRUNG (THUONG + XIN NHAT + LUCK 2.5T BAY VAO) + DANH SACH
--========================================================
local function BuildEggs()
    local TakePage = D.UI.TakePage
    local TakeLayout = D.UI.TakeLayout
    local ActiveEggs = D.UI.ActiveEggs

    local RefreshEggs

    local EggsModule
    pcall(function()
        EggsModule = require(
            RS:WaitForChild("GameData", 5):WaitForChild("Eggs", 5)
        )
    end)

    local function FormatNumber(n)
        n = tonumber(n) or 0
        if n >= 1e12 then return string.format("%.2fT", n / 1e12)
        elseif n >= 1e9 then return string.format("%.2fB", n / 1e9)
        elseif n >= 1e6 then return string.format("%.2fM", n / 1e6)
        elseif n >= 1e3 then return string.format("%.2fK", n / 1e3)
        end
        return tostring(n)
    end

    local function GetEggInfo(Egg)
        local EggName = Egg and Egg:GetAttribute("Egg")
        if not EggName then return nil, 0 end
        local Luck = tonumber(Egg:GetAttribute("Luck")) or 0
        if EggsModule then
            pcall(function()
                local Data = EggsModule[EggName]
                if type(Data) == "table" then
                    Luck = tonumber(Data.Luck) or Luck
                end
            end)
        end
        return EggName, Luck
    end

    local function FindPrompt(Egg)
        if not Egg or not Egg.Parent then return nil end
        local Prompt = Egg:FindFirstChildWhichIsA("ProximityPrompt", true)
        if Prompt then return Prompt end

        local Position = Egg:GetAttribute("Position")
        if typeof(Position) ~= "Vector3" then return nil end

        for _, Object in ipairs(workspace:GetDescendants()) do
            if Object:IsA("ProximityPrompt") then
                local Parent = Object.Parent
                if Parent and Parent:IsA("BasePart")
                    and (Parent.Position - Position).Magnitude <= 8 then
                    return Object
                end
            end
        end
        return nil
    end

    local function IsGone(Egg)
        return (not Egg) or (not Egg.Parent) or (Egg.Parent ~= ActiveEggs)
    end

    local function IdleText(Button)
        return Button:GetAttribute("Idle") or "NHẶT"
    end

    local function ResetText(Button, Delay)
        task.wait(Delay or 0.7)
        if Button and Button.Parent then Button.Text = IdleText(Button) end
    end

    -- trung Luck >= 2.5T: bay toi + tim loi vao, khong tele
    local function IsFlyInEgg(Egg)
        local _, luck = GetEggInfo(Egg)
        return luck >= S.FlyInLuck * 0.999
    end

    local function DoPick(Egg, Button)
        local Home = D.Home
        if not Home then
            Button.Text = "CHƯA ĐẶT VỊ TRÍ"
            return ResetText(Button, 1)
        end
        if IsGone(Egg) then
            Button.Text = "KHÔNG CÒN"
            return ResetText(Button, 0.6)
        end

        local Root, Hum = GetChar()
        if not Root then return end

        local PickStart = os.clock()
        local ExpireClock = nil
        local FlyIn = IsFlyInEgg(Egg) and D.FlyTo ~= nil

        if S.AutoRide and D.TryRide then
            Button.Text = "ĐANG CHỌN THÚ CƯỠI..."
            local rideOk, rideRes = pcall(D.TryRide)
            if not rideOk then
                warn("LOI CUOI THU:", rideRes)
            elseif not rideRes then
                Button.Text = "KHÔNG CƯỠI: " .. tostring(D.RideNote)
                task.wait(0.8)
            end
        end

        local Picked = false
        Button.Text = "TỚI TRỨNG..."

        for attempt = 1, 10 do
            if D.Cancel then break end
            if IsGone(Egg) then
                Picked = true
                break
            end

            Root, Hum = GetChar()
            if not Root then return end

            if D.GetRemaining then
                local rem = D.GetRemaining(Egg)
                if rem then ExpireClock = os.clock() + rem end
            end

            local Position = Egg:GetAttribute("Position")
            if typeof(Position) == "Vector3" then
                local goal = Position + Vector3.new(0, 3, 0)
                if FlyIn then
                    -- bay toi va tim loi vao (khong tele)
                    if (Root.Position - goal).Magnitude > 8 then
                        D.FlyTo(Root, Hum, goal, {
                            Maze = true,
                            OnStatus = function(dist, climbing, spd)
                                if Button and Button.Parent then
                                    Button.Text = "TÌM LỐI VÀO " .. math.floor(dist)
                                        .. "m  " .. math.floor(spd) .. "/s"
                                end
                            end,
                        })
                        Root, Hum = GetChar()
                        if not Root then return end
                        if D.Cancel then break end
                    end
                else
                    Root.CFrame = CFrame.new(goal)
                    Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end

            if attempt == 1 then task.wait(0.5) end

            local Prompt = FindPrompt(Egg)
            Button.Text = "ĐANG NHẶT " .. attempt .. "/10"

            if Prompt then
                if typeof(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, Prompt)
                else
                    pcall(function()
                        Prompt:InputHoldBegin()
                        task.wait(math.max(Prompt.HoldDuration, 0.15))
                        Prompt:InputHoldEnd()
                    end)
                end
            end

            for _ = 1, 6 do
                task.wait(0.1)
                if IsGone(Egg) then
                    Picked = true
                    break
                end
            end
            if Picked then break end
        end

        if D.Cancel then
            Button.Text = "ĐÃ DỪNG"
            return ResetText(Button, 0.7)
        end

        if not Picked then
            Button.Text = "NHẶT THẤT BẠI - ĐỨNG LẠI"
            return ResetText(Button, 1.5)
        end

        if not ExpireClock then
            ExpireClock = PickStart + S.ManualTime
        end

        local Deadline = ExpireClock - S.Reserve

        Button.Text = "ĐÃ NHẶT - BAY VỀ"
        task.wait(0.2)

        Root, Hum = GetChar()
        if not Root then return end

        local Arrived = D.FlyTo(Root, Hum, Home.Position, {
            Deadline = Deadline,
            OnStatus = function(dist, climbing, spd)
                if Button and Button.Parent then
                    local icon = "BAY "
                    if climbing then icon = "LÊN CAO " end
                    Button.Text = icon .. math.floor(dist) .. "m  " .. math.floor(spd) .. "/s"
                end
            end,
        })

        if Arrived and Root and Root.Parent then
            Root.CFrame = Home
            Root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            Button.Text = "TỚI NHÀ"
            task.wait(1.2)
        else
            Button.Text = "ĐÃ DỪNG"
        end
        ResetText(Button, 0.5)
    end

    local function PickEgg(Egg, Button)
        if D.Busy then return end
        D.Busy = true
        D.Cancel = false
        local ok, err = pcall(DoPick, Egg, Button)
        if not ok then warn("LOI NHAT TRUNG:", err) end
        D.Busy = false
        D.Cancel = false
        if Button and Button.Parent then Button.Text = IdleText(Button) end
    end

    -- nut nhat trung xin nhat (Luck cao nhat trong server)
    local function FindBestEgg()
        local best, bestName, bestLuck
        for _, Egg in ipairs(ActiveEggs:GetChildren()) do
            local name, luck = GetEggInfo(Egg)
            if name and (not best or luck > bestLuck) then
                best, bestName, bestLuck = Egg, name, luck
            end
        end
        return best, bestName, bestLuck
    end

    local BestBtn = MakeButton(
        TakePage, "NHẶT TRỨNG XỊN NHẤT",
        Color3.fromRGB(200, 140, 30), UDim2.new(1, -5, 0, 44)
    )
    BestBtn.LayoutOrder = -80
    BestBtn.TextWrapped = true
    BestBtn:SetAttribute("Idle", "NHẶT TRỨNG XỊN NHẤT")

    local function UpdateBest()
        local Egg, Name, Luck = FindBestEgg()
        local txt
        if Egg then
            txt = "NHẶT TRỨNG XỊN NHẤT\n" .. tostring(Name) .. "  |  Luck " .. FormatNumber(Luck)
        else
            txt = "NHẶT TRỨNG XỊN NHẤT\n(hiện chưa có trứng)"
        end
        BestBtn:SetAttribute("Idle", txt)
        if not D.Busy then BestBtn.Text = txt end
    end

    BestBtn.Activated:Connect(function()
        if D.Busy then return end
        local Egg = FindBestEgg()
        if not Egg then
            BestBtn.Text = "KHÔNG CÓ TRỨNG NÀO"
            task.wait(0.8)
            UpdateBest()
            return
        end
        PickEgg(Egg, BestBtn)
    end)

    local EggRows = {}

    local function CreateEggRow(Egg)
        local EggName, Luck = GetEggInfo(Egg)
        if not EggName then return end

        local Row = Instance.new("Frame")
        Row.Name = "Egg_" .. tostring(EggName)
        Row.Size = UDim2.new(1, -5, 0, 58)
        Row.BackgroundColor3 = Color3.fromRGB(40, 30, 65)
        Row.BorderSizePixel = 0
        Row.Parent = TakePage
        Style(Row, 9)

        local Info = Instance.new("TextLabel")
        Info.BackgroundTransparency = 1
        Info.Position = UDim2.new(0, 10, 0, 4)
        Info.Size = UDim2.new(1, -150, 1, -8)
        Info.Text = tostring(EggName) .. "\nLuck: " .. FormatNumber(Luck)
        Info.TextColor3 = Color3.new(1, 1, 1)
        Info.Font = Enum.Font.GothamBold
        Info.TextSize = 11
        Info.TextXAlignment = Enum.TextXAlignment.Left
        Info.TextYAlignment = Enum.TextYAlignment.Center
        Info.Parent = Row

        local Button = MakeButton(Row, "NHẶT", ON, UDim2.new(0, 130, 0, 34), UDim2.new(1, -136, 0.5, -17))
        Button.TextSize = 9
        Button.TextWrapped = true

        EggRows[EggName] = Row

        Button.Activated:Connect(function()
            if D.Busy then return end

            local TargetEgg
            for _, CurrentEgg in ipairs(ActiveEggs:GetChildren()) do
                if CurrentEgg:GetAttribute("Egg") == EggName then
                    TargetEgg = CurrentEgg
                    break
                end
            end

            if not TargetEgg then
                Button.Text = "KHÔNG CÒN"
                task.wait(0.5)
                RefreshEggs()
                return
            end

            PickEgg(TargetEgg, Button)
        end)
    end

    local Queued = false

    RefreshEggs = function()
        if D.Busy then
            if not Queued then
                Queued = true
                task.spawn(function()
                    while D.Busy do task.wait(0.3) end
                    Queued = false
                    RefreshEggs()
                end)
            end
            return
        end

        for _, Row in pairs(EggRows) do
            if Row then Row:Destroy() end
        end
        EggRows = {}

        local EggTypes, Order = {}, {}
        for _, Egg in ipairs(ActiveEggs:GetChildren()) do
            local EggName = Egg:GetAttribute("Egg")
            if EggName and not EggTypes[EggName] then
                EggTypes[EggName] = Egg
                table.insert(Order, EggName)
            end
        end

        table.sort(Order)
        for _, EggName in ipairs(Order) do
            CreateEggRow(EggTypes[EggName])
        end

        UpdateBest()

        task.defer(function()
            TakePage.CanvasSize = UDim2.new(0, 0, 0, TakeLayout.AbsoluteContentSize.Y + 10)
        end)
    end

    D.Refresh = RefreshEggs

    ActiveEggs.ChildAdded:Connect(function()
        task.wait(0.1)
        RefreshEggs()
    end)

    ActiveEggs.ChildRemoved:Connect(function()
        task.wait(0.1)
        RefreshEggs()
    end)

    RefreshEggs()
    return true
end

