function D.Status(msg, isError, life)
    msg = tostring(msg)
    warn("[BA KHI]", msg)
    pcall(function()
        for _, c in ipairs(Containers()) do
            local old = c:FindFirstChild("MA_STATUS_GUI")
            if old then old:Destroy() end
        end

        local multi = string.find(msg, "\n", 1, true) ~= nil
        local compact = (not isError) and (not multi)

        local accent = Color3.fromRGB(70, 210, 130)
        if isError then
            accent = Color3.fromRGB(235, 80, 95)
        elseif multi then
            accent = Color3.fromRGB(130, 90, 230)
        end

        local sg = Instance.new("ScreenGui")
        sg.Name = "MA_STATUS_GUI"
        sg.ResetOnSpawn = false
        sg.DisplayOrder = 999

        local card = Instance.new("Frame")
        card.AnchorPoint = Vector2.new(0.5, 0)
        card.Position = UDim2.new(0.5, 0, 0, -80)
        card.BackgroundColor3 = Color3.fromRGB(22, 18, 38)
        card.BorderSizePixel = 0
        card.Parent = sg

        local stroke = Instance.new("UIStroke")
        stroke.Color = accent
        stroke.Transparency = 0.4
        stroke.Thickness = 1
        stroke.Parent = card

        if compact then
            card.Size = UDim2.new(0, 0, 0, 34)
            card.AutomaticSize = Enum.AutomaticSize.X

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 17)
            corner.Parent = card

            local pad = Instance.new("UIPadding")
            pad.PaddingLeft = UDim.new(0, 12)
            pad.PaddingRight = UDim.new(0, 18)
            pad.Parent = card

            local list = Instance.new("UIListLayout")
            list.FillDirection = Enum.FillDirection.Horizontal
            list.VerticalAlignment = Enum.VerticalAlignment.Center
            list.Padding = UDim.new(0, 8)
            list.Parent = card

            local dot = Instance.new("Frame")
            dot.Size = UDim2.new(0, 10, 0, 10)
            dot.BackgroundColor3 = accent
            dot.BorderSizePixel = 0
            dot.Parent = card
            local dc = Instance.new("UICorner")
            dc.CornerRadius = UDim.new(1, 0)
            dc.Parent = dot

            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(0, 0, 1, 0)
            label.AutomaticSize = Enum.AutomaticSize.X
            label.BackgroundTransparency = 1
            label.Text = msg
            label.TextColor3 = Color3.fromRGB(240, 240, 250)
            label.Font = Enum.Font.GothamBold
            label.TextSize = 13
            label.Parent = card
        else
            local _, nl = string.gsub(msg, "\n", "\n")
            local lines = nl + 1 + math.floor(#msg / 60)
            local h = math.clamp(26 + lines * 15, 58, 320)

            card.Size = UDim2.new(0.92, 0, 0, h)

            local cs = Instance.new("UISizeConstraint")
            cs.MaxSize = Vector2.new(400, 400)
            cs.Parent = card

            local corner = Instance.new("UICorner")
            corner.CornerRadius = UDim.new(0, 10)
            corner.Parent = card

            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(0, 4, 1, -16)
            bar.Position = UDim2.new(0, 8, 0, 8)
            bar.BackgroundColor3 = accent
            bar.BorderSizePixel = 0
            bar.Parent = card
            local bc = Instance.new("UICorner")
            bc.CornerRadius = UDim.new(1, 0)
            bc.Parent = bar

            local box = Instance.new("TextBox")
            box.Position = UDim2.new(0, 20, 0, 6)
            box.Size = UDim2.new(1, -56, 1, -12)
            box.BackgroundTransparency = 1
            box.TextColor3 = Color3.fromRGB(235, 235, 245)
            box.Font = Enum.Font.Gotham
            box.TextSize = 11
            box.TextWrapped = true
            box.TextXAlignment = Enum.TextXAlignment.Left
            box.TextYAlignment = Enum.TextYAlignment.Top
            box.MultiLine = true
            box.ClearTextOnFocus = false
            box.Text = msg
            box.Parent = card

            local close = Instance.new("TextButton")
            close.Size = UDim2.new(0, 24, 0, 24)
            close.Position = UDim2.new(1, -30, 0, 6)
            close.BackgroundColor3 = Color3.fromRGB(45, 38, 70)
            close.BorderSizePixel = 0
            close.Text = "X"
            close.TextColor3 = Color3.fromRGB(235, 235, 245)
            close.Font = Enum.Font.GothamBold
            close.TextSize = 11
            close.Parent = card
            local cc = Instance.new("UICorner")
            cc.CornerRadius = UDim.new(0, 6)
            cc.Parent = close
            close.Activated:Connect(function() sg:Destroy() end)
        end

        sg.Parent = Containers()[1]

        TweenService:Create(
            card,
            TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {Position = UDim2.new(0.5, 0, 0, 10)}
        ):Play()

        local life2 = life
        if not life2 then
            if isError then life2 = 90
            elseif multi then life2 = 60
            else life2 = 2.5 end
        end

        task.delay(life2, function()
            pcall(function()
                TweenService:Create(
                    card,
                    TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
                    {Position = UDim2.new(0.5, 0, 0, -80)}
                ):Play()
                task.wait(0.3)
                sg:Destroy()
            end)
        end)
    end)
end

