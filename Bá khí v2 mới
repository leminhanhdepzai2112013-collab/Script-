local function RefreshMenu()

    if not ActiveEggs then
        return
    end

    local CurrentLuck = {}

    for _,Egg in
        ipairs(ActiveEggs:GetChildren()) do

        local EggName,Luck =
            GetEggInfo(Egg)

        if EggName and Luck > 0 then
            CurrentLuck[Luck] = true
        end

    end

    for Luck in pairs(CurrentLuck) do
        CreateLuckButton(Luck)
    end

    for Luck,Button in pairs(LuckButtons) do

        if not CurrentLuck[Luck] then

            Button:Destroy()

            LuckButtons[Luck] = nil
            SelectedLuck[Luck] = nil

        end

    end

    task.defer(function()

        LookPage.CanvasSize =
            UDim2.new(
                0,
                0,
                0,
                LookLayout.AbsoluteContentSize.Y + 10
            )

    end)

    UpdateESP()

end

