--========================================================
-- FORMAT NUMBER
--========================================================

local function FormatNumber(Number)

    Number = tonumber(Number) or 0

    if Number >= 1000000000000 then
        return string.format("%.2fT",Number/1000000000000)

    elseif Number >= 1000000000 then
        return string.format("%.2fB",Number/1000000000)

    elseif Number >= 1000000 then
        return string.format("%.2fM",Number/1000000)

    elseif Number >= 1000 then
        return string.format("%.2fK",Number/1000)

    else
        return tostring(Number)
    end

end

--========================================================
-- GET EGG INFO
--========================================================

local function GetEggInfo(Egg)

    if not Egg then
        return nil,0
    end

    local EggName =
        Egg:GetAttribute("Egg")

    if not EggName then
        EggName = Egg.Name
    end

    local Luck =
        tonumber(Egg:GetAttribute("Luck")) or 0

    if EggsModule and EggName then

        pcall(function()

            local Data =
                EggsModule[EggName]

            if type(Data) == "table" then

                Luck =
                    tonumber(Data.Luck) or Luck

            end

        end)

    end

    return EggName,Luck

end

