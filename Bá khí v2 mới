end)

--========================================================
-- TELEPORT
--========================================================

local function Teleport(CFrame)

    local Root =
        GetRoot()

    if Root and CFrame then
        Root.CFrame = CFrame
    end

end

--========================================================
-- LẤY VỊ TRÍ TRỨNG
--========================================================

local function GetEggPosition(Egg)

    if not Egg then
        return nil
    end

    local Position =
        Egg:GetAttribute("Position")

    if typeof(Position) == "Vector3" then
        return Position
    end

    if Egg:IsA("BasePart") then
        return Egg.Position
    end

    if Egg:IsA("Model") then

        local Part =
            Egg.PrimaryPart
            or Egg:FindFirstChildWhichIsA(
                "BasePart",
                true
            )

        if Part then
            return Part.Position
        end

    end

    return nil

end

--========================================================
-- TÌM PROMPT
--========================================================

local function FindPrompt(Egg)

    if not Egg then
        return nil
    end

    local Prompt =
        Egg:FindFirstChildWhichIsA(
            "ProximityPrompt",
            true
        )

    if Prompt then
        return Prompt
    end

    local Position =
        GetEggPosition(Egg)

    if not Position then
        return nil
    end

    local Best
    local BestDistance = 12

    for _,Object in
        ipairs(workspace:GetDescendants()) do

        if Object:IsA("ProximityPrompt") then

            local Parent =
                Object.Parent

            if Parent and
                Parent:IsA("BasePart") then

                local Distance =
                    (Parent.Position-Position).Magnitude

                if Distance < BestDistance then

                    BestDistance = Distance
                    Best = Object

                end

            end

        end

    end

    return Best

end

--========================================================
-- NHẶT TRỨNG
--========================================================

local function PickEgg(Egg)

    local Root =
        GetRoot()

    if not Root then
        return
    end

    local Position =
        GetEggPosition(Egg)

    if not Position then
        return
    end

    -- LƯU CHỖ CŨ
    SavedPosition =
        Root.CFrame

    -- TELE ĐẾN TRỨNG
    Teleport(
        CFrame.new(
            Position + Vector3.new(0,3,0)
        )
    )

    task.wait(0.35)

    local Prompt =
        FindPrompt(Egg)

    if Prompt then

        pcall(function()

            if typeof(fireproximityprompt) ==
                "function" then

                fireproximityprompt(Prompt)

            else

                Prompt:InputHoldBegin()

                task.wait(
                    math.max(
                        Prompt.HoldDuration,
                        0.2
                    )
                )

                Prompt:InputHoldEnd()

            end

        end)

    end

    task.wait(0.5)

    -- VỀ CHỖ CŨ
    if SavedPosition then
        Teleport(SavedPosition)
    end

end

